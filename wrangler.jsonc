{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payments-app",
  "account_id": "421ce01598da0a015e51b52808f58aa9",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // React SPA: unknown paths fall back to index.html so /dashboard survives a refresh.
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Hono worker; every other file is served straight from the edge.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payments-app-db",
      "database_id": "608c4b77-792f-4bf5-95f9-4711a7375547",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets are not kept in this file:
  //   JWT_SECRET  local: .dev.vars  ·  production: `npx wrangler secret put JWT_SECRET`
  "observability": { "enabled": true }
}
